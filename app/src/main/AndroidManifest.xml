<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- 桌面入口：仅作为图标载体（可被"隐藏桌面图标"开关禁用，不影响 LSPosed 打开设置） -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 配置界面（无桌面图标）：
             MODULE_SETTINGS 是 Xposed/LSPosed 官方的模块设置 category，
             LSPosed 管理器通过它打开本页，与桌面图标状态完全无关（参考 CustoMIUIzer 的做法）。 -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- LSPosed / Xposed 模块声明 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <!-- xposedminversion >= 93 且声明 xposedsharedprefs=true 是 Android 7+ 上
             XSharedPreferences 跨进程读取生效的前提（缺失会导致 Hook 侧读不到配置） -->
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedsharedprefs"
            android:value="true" />
    </application>

</manifest>
