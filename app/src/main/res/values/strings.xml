<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">WiFi伪装</string>
    <string name="xposed_description">让 LSPosed 作用域内的目标应用把当前网络识别为 WiFi（通用模块）</string>
    <string name="enable">启用模拟</string>
    <string name="section_wifi">WiFi 参数</string>
    <string name="hint_ssid">SSID 名称（默认 AndroidAP）</string>
    <string name="hint_bssid">BSSID（格式 AA:BB:CC:DD:EE:FF）</string>
    <string name="hint_ip">IP 地址（如 192.168.1.100）</string>
    <string name="hint_network_id">网络 ID（默认 0）</string>
    <string name="save">保存配置</string>
    <string name="hide_icon">隐藏桌面图标</string>
    <string name="desc_hide_icon">开启后桌面图标消失（模块功能不受影响），仍可在 LSPosed 管理器中打开模块设置页。恢复图标：设置 → 应用 → WiFi伪装 → 启用，或 adb 执行 pm enable com.zhangzc.wifispoof/.ui.MainActivity</string>
    <string name="desc_enable">通用工具：按 LSPosed「作用域」生效，作用域勾选哪些应用就对哪些应用生效。开启后请强停目标应用使其重新检测网络。</string>
    <string name="tip_reload">提示：保存后请强制停止目标应用使其重新检测网络。</string>
</resources>
